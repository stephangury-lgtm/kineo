# Production : aucune variable requise, le projet reste fixé dans le code.
# Staging : activer explicitement et fournir un AUTRE projet. Aucun secret ici.
# VITE_BACKEND_ENV=staging
# VITE_SUPABASE_URL=https://<projet-de-test>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<cle-publique-du-projet-de-test>

