{
  "name": "kineo-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-build.mjs",
    "preview": "vite preview",
    "cf:preview": "wrangler preview",
    "cf:deploy": "wrangler deploy",
    "check:source": "node scripts/check-source-robustness.mjs",
    "check:health": "node scripts/check-release-health.mjs",
    "check:prod": "node scripts/check-production.mjs",
    "check:security": "node scripts/check-security-contracts.mjs",
    "test:unit": "node --test tests/unit/curriculum-quiz-api.test.cjs tests/unit/*.test.mjs",
    "release:prepare": "node scripts/build-release-candidates.mjs",
    "test:rollback": "playwright test --config=playwright.rollback.config.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
